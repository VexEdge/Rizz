local camera = workspace.CurrentCamera

local zoomEnabled = false  -- This will track whether zoom is enabled via toggle
local zoomedIn = false    -- To track whether we are currently zoomed in or not
local zoomFOV = 30        -- The field of view for zoomed-in state
local defaultFOV = 70     -- Default field of view
local originalFOV = defaultFOV -- Variable to store the original FOV before zooming

-- Function to set the Default FOV for the player in ReplicatedStorage
local function updateFOV(value)
    local playerFolder = game.ReplicatedStorage.Players:FindFirstChild(player.Name)

    if playerFolder then
        local settings = playerFolder:FindFirstChild("Settings")
        local gameplaySettings = settings and settings:FindFirstChild("GameplaySettings")

        if gameplaySettings then
            if gameplaySettings:GetAttribute("DefaultFOV") ~= nil then
                gameplaySettings:SetAttribute("DefaultFOV", tostring(value)) -- Store as a string
                print("Default FOV set to: " .. tostring(value))
            else
                warn("Attribute 'DefaultFOV' does not exist in GameplaySettings for player " .. player.Name)
            end
        else
            warn("GameplaySettings folder not found inside Settings for player " .. player.Name)
        end
    else
        warn("Player folder not found in ReplicatedStorage for player " .. player.Name)
    end
end

-- Toggle for "Trick Spammer"
ClientSided:AddToggle({
    Name = "Zoom in. fr",
    Flag = "FarmingSection_TrickSpammer",
    Keybind = 1,
    Callback = function(value)
        zoomEnabled = value  -- Update zoomEnabled state based on toggle
        if not zoomEnabled and zoomedIn then
            camera.FieldOfView = originalFOV  -- Reset to original FOV if zoom is disabled
            zoomedIn = false
        end
    end
})

-- Listen for MB2 (middle mouse button) input to zoom in when the toggle is enabled
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end  -- Ignore if the game has already processed this input

    if zoomEnabled and input.UserInputType == Enum.UserInputType.MouseButton2 then
        -- If middle mouse button is held and zoom is enabled, store the original FOV and zoom in
        originalFOV = camera.FieldOfView  -- Store the current FOV before zooming
        camera.FieldOfView = zoomFOV
        zoomedIn = true
    end
end)

-- Listen for when MB2 is released to revert zoom
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        -- Revert zoom when MB2 is released, but only if zoom is enabled
        if zoomEnabled and zoomedIn then
            camera.FieldOfView = originalFOV  -- Restore the original FOV
            zoomedIn = false
        end
    end
end)

-- Add a slider for changing the FOV
ClientSided:AddSlider({
    Name = "Zoom in value",
    Flag = "FarmingSection_FOVSlider",
    Value = defaultFOV,  -- Default FOV value
    Min = 20,            -- Minimum FOV
    Max = 120,           -- Maximum FOV
    Precise = 2,         -- Precision for the slider
    Callback = function(value)
        -- Update the camera's FOV immediately when the slider value changes
        camera.FieldOfView = value
        -- Update the player's FOV setting in ReplicatedStorage
        updateFOV(value)
        -- If zoom is enabled and zoomed in, adjust the originalFOV accordingly
        if zoomEnabled and zoomedIn then
            originalFOV = value  -- Adjust original FOV to match the new slider value when zoom is active
        end
    end
})






